---
import Layout from "../../components/layout/BaseLayout.astro";
import WebCodeEditor from "../../tools/WebEditor/WebEditor";
import EveryDayUtils from "../../tools/EveryDayUtils/UtilsApp";
import CVBuilder from "../../tools/CVBuilder/CVBuilder";
import WeekPlanner from "../../tools/WeekPlanner/WeekPlanner";
import FinancePlanner from "../../tools/FinancePlanner/FinancePlanner";
import ImageTools from "../../tools/ImageTools/ImageTools";
import CookingBook from "../../tools/CookingBook/CookingBook";
import "../../tools/theme.css";

const ToolNames = [
	"WebCodeEditor",
	"EveryDayUtils",
	"CVBuilder",
	"WeekPlanner",
	"FinancePlanner",
	"ImageTools",
	"CookingBook",
] as const;

export function getStaticPaths() {
	return ToolNames.map((tool) => ({
		params: { name: tool },
	}));
}

const { name } = Astro.params;
---

<Layout title={name + " | andre_OS"}>
	<div class="flex flex-col min-h-screen">
		{
			(() => {
				switch (name) {
					case "WebCodeEditor":
						return <WebCodeEditor client:load />;
					case "EveryDayUtils":
						return <EveryDayUtils client:load />;
					case "CVBuilder":
						return <CVBuilder client:load />;
					case "WeekPlanner":
						return <WeekPlanner client:load />;
					case "FinancePlanner":
						return <FinancePlanner client:load />;
					case "ImageTools":
						return <ImageTools client:load />;
					case "CookingBook":
						return (
							<CookingBook client:only="react">
								<p
									slot="fallback"
									class="p-8 text-sm text-[var(--color-muted)]"
								>
									Carregando livro de receitas…
								</p>
							</CookingBook>
						);
					default:
						return <div>Ferramenta não encontrada.</div>;
				}
			})()
		}
	</div>
</Layout>

---
import SEOLayout from "../../components/layout/SEOLayout.astro";
import AppLayout from "@/components/layout/AppLayout.astro";
import ScratchPad from "../../tools/ScratchPad/ScratchPad";
import EveryDayUtils from "../../tools/EveryDayUtils/UtilsApp";
import CVBuilder from "../../tools/CVBuilder/CVBuilder";
import WeekPlanner from "../../tools/WeekPlanner/WeekPlanner";
import FinancePlanner from "../../tools/FinancePlanner/FinancePlanner";
import FirePlanner from "../../tools/FirePlanner/FirePlanner";
import ImageTools from "../../tools/ImageTools/ImageTools";
import CookingBook from "../../tools/CookingBook/CookingBook";
import RssReader from "../../tools/RssReader/RssReader";
export function getStaticPaths() {
	const ToolNames = [
		"ScratchPad",
		"EveryDayUtils",
		"CVBuilder",
		"WeekPlanner",
		"FinancePlanner",
		"FirePlanner",
		"ImageTools",
		"CookingBook",
		"RssReader",
	] as const;

	return ToolNames.map((tool) => ({
		params: { name: tool },
	}));
}

const { name } = Astro.params;
const toolName = name ?? "";
---

<SEOLayout title={`${toolName} · André`}>
	<AppLayout>
		{
			(() => {
				switch (name) {
					case "ScratchPad":
						return <ScratchPad client:load />;
					case "EveryDayUtils":
						return <EveryDayUtils client:load />;
					case "CVBuilder":
						return <CVBuilder client:load />;
					case "WeekPlanner":
						return <WeekPlanner client:load />;
					case "FinancePlanner":
						return <FinancePlanner client:load />;
					case "FirePlanner":
						return <FirePlanner client:load />;
					case "ImageTools":
						return <ImageTools client:load />;
					case "CookingBook":
						return <CookingBook client:load />;
					case "RssReader":
						return <RssReader client:load />;
					default:
						return <div>Ferramenta não encontrada.</div>;
				}
			})()
		}
	</AppLayout>
</SEOLayout>

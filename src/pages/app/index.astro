---
import { getCollection } from "astro:content";
import HubListingLayout from "@/components/layout/HubListingLayout.astro";
import SEOLayout from "@/components/layout/SEOLayout.astro";
import { pageTitle } from "@/content/site";

const entries = (await getCollection("posts")).map((entry) => entry.data);

const appPosts = entries
    .filter((p) => p.type == "tool")
    .sort((a, b) => {
        return b.date.getTime() - a.date.getTime();
    });

const categoryParam = "tool";
---

<SEOLayout title={pageTitle("Ferramentas")}>
    <HubListingLayout recentPosts={appPosts} activeCategory={categoryParam} />
</SEOLayout>

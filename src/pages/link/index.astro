---
import { getCollection } from "astro:content";
import DirectoryLayout from "@/components/layout/DirectoryLayout.astro";
import DocumentLayout from "@/components/layout/DocumentLayout.astro";

const entries = (await getCollection("posts")).map((entry) => entry.data);

const appPosts = entries
    .filter((p) => p.type == "link")
    .sort((a, b) => {
        return b.date.getTime() - a.date.getTime();
    });

const categoryParam = "link";
---

<DocumentLayout title="andre_OS">
    <DirectoryLayout
        recentPosts={appPosts}
        activeCategory={categoryParam}
    />
</DocumentLayout>

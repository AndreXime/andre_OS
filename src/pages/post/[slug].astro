---
import SEOLayout from "../../components/layout/SEOLayout.astro";
import MainLayout from "@/components/layout/MainLayout.astro";
import { formatDate } from "@/lib/utils";
import { pageTitle } from "@/content/site";
import { getCollection } from "astro:content";
import { marked, type Tokens } from "marked";

export async function getStaticPaths() {
	const entries = await getCollection(
		"posts",
		({ data }) => data.type === "note",
	);

	return entries.map((entry) => ({
		params: { slug: entry.data.slug },
		props: { post: { ...entry.data, content: entry.body } },
	}));
}

const { post } = Astro.props;

function escapeHtml(text: string): string {
	return text
		.replace(/&/g, "&amp;")
		.replace(/</g, "&lt;")
		.replace(/>/g, "&gt;")
		.replace(/"/g, "&quot;");
}

const renderer = {
	link({ href, title, text }: Tokens.Link): string {
		return `<a href="${href}" title="${title ?? ""}" target="_blank" rel="noopener noreferrer">${text}</a>`;
	},
	code({ text, lang }: Tokens.Code): string {
		const languageClass = lang ? `language-${lang}` : "language-text";
		return `<pre><code class="${languageClass}">${escapeHtml(text)}</code></pre>`;
	},
};

marked.use({ renderer });
const htmlContent = marked.parse(post.content || "", { async: false });
---

<SEOLayout title={pageTitle(post.title)}>
	<MainLayout activeCategory="note">
		<article class="container-page py-lg pb-3xl">
			<div class="mx-auto w-full">
				<header
					class="border-b border-b-rule pb-xl pl-md border-l-[3px] border-l-accent [box-shadow:inset_3px_0_0_var(--color-accent)]"
				>
					<a
						href="/post"
						class="focus-ring mb-md inline-flex min-h-11 items-center font-mono text-sm text-muted no-underline hover:text-accent"
					>
						← Notas
					</a>
					<h1
						class="m-0 font-display text-display-s leading-snug font-semibold tracking-display text-ink"
					>
						{post.title}
					</h1>

					<p class="mt-sm font-mono text-xs text-muted">
						<time datetime={post.date.toISOString()}>
							{formatDate(post.date)}
						</time>
					</p>
				</header>

				{
					htmlContent ? (
						<div
							class="content-container pt-xl"
							set:html={htmlContent}
						/>
					) : null
				}
			</div>
		</article>
	</MainLayout>
</SEOLayout>

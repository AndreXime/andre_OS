---
import DocumentLayout from "../../components/layout/DocumentLayout.astro";
import ShellLayout from "@/components/layout/ShellLayout.astro";
import WindowFrame from "@/components/ui/WindowFrame.astro";
import { formatDate, truncateMiddle } from "@/lib/utils";
import { getCollection } from "astro:content";
import { ChevronLeft } from "lucide-react";
import { marked, type Tokens } from "marked";

export async function getStaticPaths() {
	const entries = await getCollection(
		"posts",
		({ data }) => data.type === "note",
	);

	return entries.map((entry) => ({
		params: { slug: entry.data.slug },
		props: { post: { ...entry.data, content: entry.body } },
	}));
}

const { post } = Astro.props;

function escapeHtml(text: string): string {
	return text
		.replace(/&/g, "&amp;")
		.replace(/</g, "&lt;")
		.replace(/>/g, "&gt;")
		.replace(/"/g, "&quot;");
}

const renderer = {
	link({ href, title, text }: Tokens.Link): string {
		return `<a href="${href}" title="${title ?? ""}" target="_blank" rel="noopener noreferrer">${text}</a>`;
	},
	code({ text, lang }: Tokens.Code): string {
		const languageClass = lang ? `language-${lang}` : "language-text";
		return `<pre><code class="${languageClass}">${escapeHtml(text)}</code></pre>`;
	},
};

marked.use({ renderer });
const htmlContent = marked.parse(post.content || "", { async: false });
const windowTitleFull = `~/notas/${post.slug}.md`;
const windowTitle = truncateMiddle(windowTitleFull, 44);
---

<DocumentLayout title={post.title + " | andre_OS"}>
	<ShellLayout activeCategory="note" statusPath={windowTitleFull}>
		<div class="mx-auto w-full max-w-5xl px-4 pt-8 pb-4">
			<div class="mb-6 flex items-center gap-4 flex-shrink-0">
				<a
					href="/post"
					class="ui-focus-ring flex items-center gap-2 px-3 py-1.5 rounded-md bg-[color-mix(in_oklch,var(--color-surface-1)_85%,transparent_15%)] border border-[var(--color-border)] hover:border-[var(--color-border-strong)] text-sm transition-colors text-[var(--color-dim)] hover:text-[var(--color-fg)] group"
				>
					<ChevronLeft
						size={16}
						className="group-hover:-translate-x-0.5 transition-transform"
					/>
					Voltar para notas
				</a>
			</div>

			<WindowFrame
				title={windowTitle}
				titleFull={windowTitleFull}
				kind="note"
				typeLabel="Nota"
				padded={false}
			>
				<div
					class="p-6 md:p-8 border-b border-[var(--color-border)] bg-[color-mix(in_oklch,var(--color-surface-2)_85%,transparent_15%)]"
				>
					<h1
						class="text-3xl md:text-4xl font-bold text-[var(--color-fg)]"
					>
						{post.title}
					</h1>
					{
						post.date && (
							<p class="mt-3 text-sm text-[var(--color-dim)] font-mono">
								{formatDate(post.date)}
							</p>
						)
					}
				</div>

				<div
					class="p-6 md:p-8 prose prose-invert prose-zinc prose-pre:text-base max-w-none"
				>
					{
						htmlContent && (
							<div
								class="text-[var(--color-muted)] leading-relaxed content-container [&>*:first-child]:mt-0"
								set:html={htmlContent}
							/>
						)
					}
				</div>
			</WindowFrame>
		</div>
	</ShellLayout>
</DocumentLayout>

---
import Layout from "../../components/layout/BaseLayout.astro";
import DetailView from "../../components/ui/DetailCard.astro";
import Header from "@/components/layout/Header.astro";
import { getCollection } from "astro:content";
import { ChevronLeft } from "lucide-react";

export async function getStaticPaths() {
	const entries = (
		await getCollection("posts", ({ data }) => data.type === "note")
	).map((entry) => entry.data);

	return entries.map((entry) => ({
		params: { slug: entry.slug },
		props: { post: entry },
	}));
}

const { post } = Astro.props;
---

<Layout title={post.title + " | andre_OS"}>
	<div class="min-h-screen relative flex flex-col">
		<Header searchParam={""} filterParam={"all"} />

		<main class="flex-1 w-full">
			<div class="mx-auto w-full max-w-5xl px-4 pt-8 pb-12">
				<div class="flex flex-col w-full">
					<div class="mb-6 flex items-center gap-4 flex-shrink-0">
						<a
							href="/"
							class="ui-focus-ring flex items-center gap-2 px-3 py-1.5 rounded-md bg-[color-mix(in_oklch,var(--color-surface-1)_85%,transparent_15%)] border border-[var(--color-border)] hover:border-[var(--color-border-strong)] text-sm transition-colors text-[var(--color-dim)] hover:text-[var(--color-fg)] group"
						>
							<ChevronLeft
								size={16}
								className="group-hover:-translate-x-0.5 transition-transform"
							/>
							Home
						</a>
						<div class="h-4 w-px bg-[var(--color-border)]"></div>
						<div
							class="flex items-center gap-2 text-xs font-mono text-[var(--color-dim)]"
						>
							<span>~/notas/{post.slug}.md</span>
						</div>
					</div>
					<DetailView post={post} />
				</div>
			</div>
		</main>
	</div>
</Layout>

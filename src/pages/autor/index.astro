---
import SEOLayout from "@/components/layout/SEOLayout.astro";
import MainLayout from "@/components/layout/MainLayout.astro";
import { AUTHOR } from "@/content/author";
import { pageTitle as buildPageTitle, SITE_NAME } from "@/content/site";
import { kindBadgeClass } from "@/lib/hubUi";
import { ExternalLinkIcon } from "lucide-react";
---

<SEOLayout
	title={buildPageTitle("Sobre mim")}
	description={`Quem escreve o ${SITE_NAME}: André Ximenes, desenvolvedor backend TypeScript. Portfólio, LinkedIn e GitHub.`}
>
	<MainLayout activeCategory="author">
		<article class="container-page py-lg pb-3xl">
			<header
				class="border-b border-b-rule pb-xl pl-md border-l-[3px] border-l-accent [box-shadow:inset_3px_0_0_var(--color-accent)]"
			>
				<p
					class="mb-sm font-mono text-xs tracking-label text-accent uppercase"
				>
					{AUTHOR.role}
				</p>
				<h1
					class="m-0 font-display text-display-s leading-snug font-semibold tracking-display text-ink"
				>
					{AUTHOR.name}
				</h1>
				<p class="mt-md text-md leading-[var(--lh-prose)] text-muted">
					{AUTHOR.lede}
				</p>
			</header>

			<div class="flex flex-col gap-lg pt-xl">
				{
					AUTHOR.body.map((paragraph) => (
						<p class="m-0 text-md leading-[var(--lh-prose)] text-ink-2">
							{paragraph}
						</p>
					))
				}

				<section
					class="flex flex-col gap-md border-t border-rule pt-md"
					aria-labelledby="author-links"
				>
					<h2
						id="author-links"
						class="m-0 font-display text-xl font-semibold text-accent"
					>
						Onde me encontrar
					</h2>
					<div
						class="overflow-x-auto [-webkit-overflow-scrolling:touch]"
					>
						<table class="w-full border-collapse tabular-nums">
							<thead class="border-b border-rule-2">
								<tr>
									<th
										scope="col"
										class="px-sm pt-2xs pb-xs text-left font-mono text-xs font-medium tracking-label text-muted uppercase"
									>
										Canal
									</th>
									<th
										scope="col"
										class="px-sm pt-2xs pb-xs text-left font-mono text-xs font-medium tracking-label text-muted uppercase"
									>
										Endereço
									</th>
								</tr>
							</thead>
							<tbody>
								{
									AUTHOR.links.map((link) => (
										<tr class="group hover:bg-accent-bg">
											<td class="w-26 px-sm py-sm align-middle">
												<span
													class={kindBadgeClass.note}
												>
													{link.label}
												</span>
											</td>
											<td class="min-w-0 px-sm py-sm align-middle">
												<a
													href={link.href}
													class="focus-ring inline-flex items-center gap-2xs font-medium text-ink no-underline group-hover:text-accent hover:text-accent hover:underline hover:underline-offset-[0.18em]"
													target="_blank"
													rel="noopener noreferrer"
												>
													<span>{link.host}</span>
													<ExternalLinkIcon />
												</a>
												<p class="mt-3xs font-mono text-xs text-muted">
													{link.description}
												</p>
											</td>
										</tr>
									))
								}
							</tbody>
						</table>
					</div>
				</section>
			</div>
		</article>
	</MainLayout>
</SEOLayout>

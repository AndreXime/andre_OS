---
import Layout from "../components/layout/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import PreviewCard from "@/components/ui/PreviewCard.astro";
import WorkbenchRow from "@/components/ui/WorkbenchRow.astro";
import { getCollection } from "astro:content";
import { sortPosts } from "@/lib/posts";

export const prerender = false;

const { searchParams } = Astro.url;
const categoryParam = searchParams.get("category") || "all";
const searchParam = searchParams.get("q") || "";

const entries = (await getCollection("posts")).map((entry) => entry.data);
const posts = sortPosts(entries);

const filteredPosts = posts.filter((post) => {
	if (categoryParam !== "all" && post.type !== categoryParam) return false;

	if (searchParam) {
		return (
			post.title.toLowerCase().includes(searchParam.toLowerCase()) ||
			post.description
				.toLowerCase()
				.includes(searchParam.toLowerCase()) ||
			post.tags.some((tag) =>
				tag.toLowerCase().includes(searchParam.toLowerCase()),
			)
		);
	}

	return true;
});

const introPosts = filteredPosts.filter((p) => p.type === "intro");
const recentPosts = filteredPosts
	.filter((p) => p.type !== "intro")
	.sort((a, b) => b.date.getTime() - a.date.getTime());

function getPostUrl(post: (typeof recentPosts)[number]) {
	switch (post.type) {
		case "note":
			return `/post/${post.slug}`;
		case "tool":
			return `/app/${post.tool_name}`;
		case "link":
			return post.url ?? "#";
		default:
			return "#";
	}
}

const showEmpty = filteredPosts.length === 0;
---

<Layout title="andre_OS">
	<div class="min-h-screen relative flex flex-col">
		<Header searchParam={searchParam} filterParam={categoryParam} />

		<main class="flex-1 w-full">
			<div class="mx-auto w-full max-w-5xl px-4 pt-8 pb-12 space-y-8">
				{
					introPosts.length ? (
						<section class="space-y-3">
							<div class="flex items-center justify-between">
								<h2 class="font-mono text-xs uppercase tracking-widest text-[var(--color-dim)]">
									~/root
								</h2>
							</div>
							<div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
								{introPosts.map((item) => (
									<div
										class={`block group h-full relative ${item.featured ? "lg:col-span-2" : "col-span-1"}`}
									>
										<PreviewCard post={item} />
									</div>
								))}
							</div>
						</section>
					) : null
				}

				{
					recentPosts.length ? (
						<section class="space-y-6">
							<div class="flex items-center justify-between">
								<h2 class="font-mono text-xs uppercase tracking-widest text-[var(--color-dim)]">
									~/recentes
								</h2>
							</div>

							<div class="ui-card px-4 py-3">
								<div class="font-mono text-xs text-[var(--color-dim)]">
									<span class="text-[var(--color-accent)]">
										ls
									</span>{" "}
									-t{" "}
									<span class="text-[var(--color-muted)]">
										{categoryParam !== "all"
											? `./${categoryParam}`
											: "./"}
									</span>
									{searchParam ? (
										<span class="text-[var(--color-dim)]">
											{" "}
											| grep {searchParam}
										</span>
									) : null}
								</div>
							</div>

							<div class="space-y-3">
								{recentPosts.map((item) => (
									<a
										href={getPostUrl(item)}
										{...(item.type === "link"
											? {
													target: "_blank",
													rel: "noopener noreferrer",
												}
											: {})}
										class="block"
									>
										<WorkbenchRow post={item} />
									</a>
								))}
							</div>
						</section>
					) : null
				}

				{
					showEmpty ? (
						<div class="py-20 text-center border border-dashed border-[var(--color-border)] rounded-lg">
							{searchParam ? (
								<>
									<p class="text-[var(--color-dim)] text-lg">
										Nenhum resultado encontrado para{" "}
										{`"${searchParam}"`}.
									</p>
									<a
										href="/"
										class="mt-4 inline-block text-[var(--color-accent)] hover:underline"
									>
										Limpar filtros
									</a>
								</>
							) : (
								<div class="py-20 text-center">
									<p class="text-[var(--color-dim)] text-lg">
										Por enquanto não foi publicado nenhum
										post
									</p>
								</div>
							)}
						</div>
					) : null
				}
			</div>
		</main>
	</div>
</Layout>

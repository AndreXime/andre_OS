---
import Layout from "../components/layout/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Sidebar from "../components/layout/Sidebar.astro";
import PreviewCard from "@/components/ui/PreviewCards";
import { getCollection } from "astro:content";
import {
	entryToPost,
	getLastPostDate,
	getPostsTags,
	sortPosts,
} from "@/lib/posts";

export const prerender = false;

const { searchParams } = Astro.url;
const categoryParam = searchParams.get("category") || "all";
const searchParam = searchParams.get("q") || "";

const entries = sortPosts(await getCollection("posts"));
const posts = entries.map(entryToPost);
const tags = getPostsTags(entries);
const lastDate = getLastPostDate(entries);

const filteredPosts = posts.filter((post) => {
	if (categoryParam !== "all" && post.type !== categoryParam) return false;

	if (searchParam) {
		return (
			post.title.toLowerCase().includes(searchParam.toLowerCase()) ||
			post.description
				.toLowerCase()
				.includes(searchParam.toLowerCase()) ||
			post.tags.some((tag) =>
				tag.toLowerCase().includes(searchParam.toLowerCase()),
			)
		);
	}

	return true;
});
---

<Layout title="andre_OS">
	<div class="min-h-screen relative flex flex-col lg:flex-row">
		<Header searchParam={searchParam} filterParam={categoryParam} />

		<div
			class="flex-1 pt-8 px-4 pb-1 mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 transition-all"
		>
			<Sidebar
				tagCounts={tags}
				lastDate={lastDate}
				currentFilter={categoryParam}
				currentSearch={searchParam}
			/>

			<main class={`flex lg:col-span-10`}>
				<div
					class="grid gap-4 grid-flow-dense grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 auto-rows-min w-full"
				>
					{
						filteredPosts && filteredPosts.length > 0 ? (
							filteredPosts.map((item) => {
								let itemUrl = "";

								switch (item.type) {
									case "note":
										itemUrl = `/post/${item.slug}`;
										break;

									case "link":
										itemUrl = `${item.url}`;
										break;

									case "tool":
										itemUrl = `/app/${item.tool_name}`;
										break;
									default:
										itemUrl = "";
										break;
								}

								if (item.type == "intro") {
									return (
										<div
											class={`block group h-full relative ${item.featured ? "md:col-span-2" : "col-span-1"} outline-none focus-visible:ring-2 ring-emerald-500/50 rounded-md`}
										>
											<PreviewCard post={item} />
										</div>
									);
								}

								return (
									<a
										href={itemUrl}
										{...(item.type === "link"
											? {
													target: "_blank",
													rel: "noopener noreferrer",
												}
											: {})}
										class={`block group h-full relative ${item.featured ? "md:col-span-2" : "col-span-1"} outline-none focus-visible:ring-2 ring-emerald-500/50 rounded-md`}
									>
										<PreviewCard post={item} />
									</a>
								);
							})
						) : (
							<div class="col-span-full py-20 text-center border border-dashed border-zinc-800 rounded-lg ">
								{searchParam ? (
									<>
										<p class="text-zinc-500 text-lg">
											Nenhum resultado encontrado para
											{`"${searchParam}"`}.
										</p>
										<a
											href="/"
											class="mt-4 inline-block text-emerald-500 hover:underline"
										>
											Limpar filtros
										</a>
									</>
								) : (
									<div class="col-span-full py-20 text-center border border-dashed border-zinc-800 rounded-lg ">
										<p class="text-zinc-500 text-lg">
											Por enquanto não foi publicado
											nenhum post
										</p>
									</div>
								)}
							</div>
						)
					}
				</div>
			</main>
		</div>
	</div>
</Layout>

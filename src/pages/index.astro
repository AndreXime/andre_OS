---
import { getCollection } from "astro:content";
import PostsLayout from "@/components/layout/PostsLayout.astro";
import BaseLayout from "@/components/layout/BaseLayout.astro";

const entries = (await getCollection("posts")).map((entry) => entry.data);

const recentPosts = entries
	.filter((p) => p.type !== "intro")
	.sort((a, b) => b.date.getTime() - a.date.getTime());

const introPost = entries.find((p) => p.type === "intro");
---

<BaseLayout title="andre_OS">
	<PostsLayout
		introPost={introPost}
		recentPosts={recentPosts}
		activeCategory="all"
	/>
</BaseLayout>

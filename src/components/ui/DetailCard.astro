---
import { formatDate, getThemeClasses } from "@/lib/utils";
import { marked, type Tokens } from "marked";
import { Terminal } from "lucide-react";
import type { Post } from "@/content.config";

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { bgClass, borderClass, badgeClass } = getThemeClasses(post.type);

const renderer = {
	link({ href, title, text }: Tokens.Link): string {
		return `<a href="${href}" title="${title ?? ""}" target="_blank" rel="noopener noreferrer">${text}</a>`;
	},
	code({ text, lang }: Tokens.Code): string {
		const languageClass = lang ? `language-${lang}` : "language-text";
		return `<pre><code class="${languageClass}">${text}</code></pre>`;
	},
};

marked.use({ renderer });
const htmlContent = marked.parse(post.content || "", { async: false });
---

<div
	class={`min-h-[200px] rounded-lg border ${borderClass} bg-zinc-900/50 backdrop-blur-sm overflow-hidden flex flex-col`}
>
	<div class={`p-6 md:p-8 border-b ${borderClass} ${bgClass} flex-shrink-0`}>
		<div class="flex gap-2 mb-4">
			{
				post.tags?.map((tag: string) => (
					<span
						class={`px-2 py-0.5 text-[10px] font-mono border rounded-sm uppercase tracking-wider ${badgeClass}`}
					>
						#{tag}
					</span>
				))
			}
		</div>
		<div class="flex items-end justify-between gap-4 mb-4">
			<h1 class="text-3xl md:text-4xl font-bold text-zinc-100">
				{post.title}
			</h1>
			{
				post.type === "tool" && (
					<a
						href={`/app/${post.tool_name ?? post.slug}`}
						class="bg-emerald-600 hover:bg-emerald-500 text-white px-6 py-2 rounded-md font-medium transition-colors flex items-center gap-2"
					>
						<Terminal size={16} />
						Ver ferramenta
					</a>
				)
			}
		</div>
		<div
			class="flex items-center justify-between gap-4 text-sm text-zinc-400 font-mono"
		>
			{post.date && <span>{formatDate(post.date)}</span>}
		</div>
	</div>

	<div
		class="p-6 md:p-8 overflow-y-auto flex-1 prose prose-invert prose-zinc prose-pre:text-base max-w-none"
	>
		{
			htmlContent && (
				<div
					class="text-zinc-200 leading-relaxed content-container [&>*:first-child]:mt-0"
					set:html={htmlContent}
				/>
			)
		}
	</div>
</div>

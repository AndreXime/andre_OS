---
import { getLinkInfo } from "@/lib/getLinkInfo";
import { formatDate } from "@/lib/utils";
import { Code2, ExternalLink, FileText } from "lucide-react";
import type { Post } from "@/content.config";
import { Image } from "astro:assets";

interface Props {
	post: Post;
}

const { post } = Astro.props;

const rowMeta = await (async () => {
	switch (post.type) {
		case "tool":
			return {
				Icon: Code2,
				kind: "tool" as const,
				kindLabel: "bin",
				path: `./bin/${post.tool_name ?? post.slug}`,
				verb: "exec",
				linkFavicon: null as string | null,
			};
		case "note":
			return {
				Icon: FileText,
				kind: "note" as const,
				kindLabel: "md",
				path: `./notas/${post.slug}.md`,
				verb: "cat",
				linkFavicon: null as string | null,
			};
		case "link": {
			const info = await getLinkInfo(post.url || "");

			return {
				Icon: ExternalLink,
				kind: "link" as const,
				kindLabel: "url",
				path: info.domain,
				verb: "open",
				linkFavicon: info.favicon,
			};
		}
		default:
			return {
				Icon: FileText,
				kind: "note" as const,
				kindLabel: "root",
				path: `./${post.slug}`,
				verb: "view",
				linkFavicon: null as string | null,
			};
	}
})();
---

<article class="group ui-card ui-focus-ring px-4 py-3">
	<div class="flex items-start gap-3">
		<div
			class={`workbench-row-icon workbench-row-icon--${rowMeta.kind} pt-0.5`}
		>
			{
				rowMeta.linkFavicon ? (
					<Image
						src={rowMeta.linkFavicon}
						alt=""
						width={20}
						height={20}
						class="size-5 rounded-sm object-contain"
						loading="lazy"
						decoding="async"
					/>
				) : (
					<rowMeta.Icon size={18} strokeWidth={1.75} />
				)
			}
		</div>

		<div class="min-w-0 flex-1">
			<div class="flex flex-wrap items-center gap-x-2 gap-y-1">
				<span
					class={`workbench-row-kind workbench-row-kind--${rowMeta.kind}`}
				>
					{rowMeta.kindLabel}
				</span>

				<span class="font-mono text-xs text-[var(--color-dim)]">
					<span class="text-[var(--color-accent)]"
						>{rowMeta.verb}</span
					>
					{" "}
					<span class="text-[var(--color-muted)]">{rowMeta.path}</span
					>
				</span>

				{
					post.date ? (
						<span class="font-mono text-xs text-[var(--color-dim)]">
							{formatDate(post.date)}
						</span>
					) : null
				}
			</div>

			<h3
				class="mt-1 text-base font-semibold text-[var(--color-fg)] leading-snug"
			>
				{post.title}
			</h3>
			<p
				class="mt-1 text-sm text-[var(--color-dim)] leading-relaxed line-clamp-2"
			>
				{post.description}
			</p>

			{
				post.tags?.length ? (
					<div class="mt-3 flex flex-wrap gap-2">
						{post.tags.map((tag) => (
							<span class="ui-pill">#{tag}</span>
						))}
					</div>
				) : null
			}
		</div>

		<div
			class="hidden lg:flex items-center gap-2 pl-4 text-[var(--color-dim)] font-mono text-xs"
		>
			<span class="uppercase tracking-widest">{rowMeta.kindLabel}</span>
			<span class="ui-prompt-arrow">{">"}</span>
		</div>
	</div>
</article>

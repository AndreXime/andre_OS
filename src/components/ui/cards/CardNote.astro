---
import { formatDate, getThemeClasses } from "@/lib/utils";
import { FileText } from "lucide-react";
import type { Post } from "@/content.config";

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { badgeClass, markerClass } = getThemeClasses(post.type);
---

<div class="ui-card ui-focus-ring cursor-pointer h-full p-4 flex flex-col relative overflow-hidden card-trigger">
	<div>
		<div class="flex items-center gap-2 mb-3">
			<span class={`text-xs font-mono ${markerClass}`}>
				<FileText size={12} className="inline -mt-0.5" /> nota
			</span>
			<span class="text-xs font-mono text-[var(--color-dim)]">
				{post.date ? formatDate(post.date) : ""}
			</span>
		</div>
		<h3 class="text-lg font-medium text-[var(--color-fg)] mb-2 leading-tight">
			{post.title}
		</h3>
		<p class="text-sm text-[var(--color-dim)] mb-4 line-clamp-4 leading-relaxed">
			{post.description}
		</p>
	</div>
	<div class="mt-auto pt-4 flex flex-col gap-3 transition-colors">
		<div class="flex gap-2 flex-wrap">
			{post.tags.map((tag: string) => (
				<span class={badgeClass}>
					#{tag}
				</span>
			))}
		</div>
		<div class="ui-prompt">
			<span class="truncate">cat ./notas/{post.slug}.md</span>
			<span class="ui-prompt-arrow shrink-0">{">"}</span>
		</div>
	</div>
</div>

---
import { getLinkInfo } from "@/lib/getLinkInfo";
import { getThemeClasses } from "@/lib/utils";
import { ExternalLink } from "lucide-react";
import type { Post } from "@/content.config";

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { badgeClass } = getThemeClasses(post.type);
const siteInfo = await getLinkInfo(post.url || "");
---

<div class="cursor-pointer h-full bg-zinc-900 border border-zinc-800 hover:border-violet-500/50 hover:bg-violet-900/5 transition-all duration-300 flex flex-col rounded-md overflow-hidden card-trigger">
	<div class="relative flex h-20 w-full items-center justify-center overflow-hidden border-b border-zinc-800 bg-gradient-to-br from-violet-900/20 to-fuchsia-900/20 group-hover:border-violet-900/30 transition-colors">
		{siteInfo.ogImage ? (
			<>
				<img
					src={siteInfo.ogImage}
					alt=""
					class="absolute inset-0 size-full object-fill object-center"
					loading="lazy"
					decoding="async"
				/>
				<div class="absolute inset-0 bg-zinc-950/50 group-hover:bg-zinc-950/30 transition-colors" />
			</>
		) : siteInfo.favicon ? (
			<img
				src={siteInfo.favicon}
				alt=""
				class="relative z-10 h-10 w-10 object-contain drop-shadow-sm"
				loading="lazy"
				decoding="async"
			/>
		) : (
			<span class="font-bold gap-1 text-xl text-white/10 tracking-widest uppercase group-hover:text-violet-500/20 transition-colors px-2">
				{siteInfo.title}
			</span>
		)}
	</div>
	<div class="p-4 flex flex-col flex-1 justify-between">
		<div>
			<h3 class="text-lg font-medium text-zinc-100 mb-2 leading-tight group-hover:text-violet-100 transition-colors">
				{post.title}
			</h3>
			<p class="text-sm text-zinc-400 mb-4 line-clamp-4 leading-relaxed">{post.description}</p>
		</div>
		<div class="mt-auto pt-4 flex flex-col gap-3 transition-colors">
			<div class="flex gap-2 flex-wrap">
				{post.tags.map((tag: string) => (
					<span class={`px-2 py-0.5 text-[10px] font-mono border rounded-sm uppercase tracking-wider ${badgeClass}`}>
						#{tag}
					</span>
				))}
			</div>
			<div class="w-full flex justify-center items-center gap-2 text-xs font-bold text-violet-400 bg-violet-950/30 hover:bg-violet-900 border border-violet-900/50 hover:border-violet-500/50 px-3 py-1.5 rounded transition-all uppercase tracking-wide">
				<ExternalLink size={12} /> Ver link
			</div>
		</div>
	</div>
</div>

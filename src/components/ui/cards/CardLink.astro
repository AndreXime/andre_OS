---
import { getLinkInfo } from "@/lib/getLinkInfo";
import { getThemeClasses } from "@/lib/utils";
import { ExternalLink } from "lucide-react";
import type { Post } from "@/content.config";

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { badgeClass, markerClass } = getThemeClasses(post.type);
const siteInfo = await getLinkInfo(post.url || "");
const linkHost = (() => {
	if (!post.url) return "link";
	try {
		return new URL(post.url).host.replace(/^www\./, "");
	} catch {
		return "link";
	}
})();
---

<div class="ui-card ui-focus-ring cursor-pointer h-full overflow-hidden card-trigger">
	<div class="relative flex h-20 w-full items-center justify-center overflow-hidden border-b border-[var(--color-border)] bg-[color-mix(in_oklch,var(--color-surface-2)_85%,transparent_15%)]">
		{siteInfo.ogImage ? (
			<>
				<img
					src={siteInfo.ogImage}
					alt=""
					class="absolute inset-0 size-full object-fill object-center"
					loading="lazy"
					decoding="async"
				/>
				<div class="absolute inset-0 bg-black/50 transition-colors" />
			</>
		) : siteInfo.favicon ? (
			<img
				src={siteInfo.favicon}
				alt=""
				class="relative z-10 h-10 w-10 object-contain drop-shadow-sm"
				loading="lazy"
				decoding="async"
			/>
		) : (
			<span class="font-bold gap-1 text-xl text-white/10 tracking-widest uppercase transition-colors px-2">
				{siteInfo.title}
			</span>
		)}
	</div>
	<div class="p-4 flex flex-col flex-1 justify-between">
		<div>
			<h3 class="text-lg font-medium text-[var(--color-fg)] mb-2 leading-tight">
				{post.title}
			</h3>
			<p class="text-sm text-[var(--color-dim)] mb-4 line-clamp-4 leading-relaxed">
				{post.description}
			</p>
		</div>
		<div class="mt-auto pt-4 flex flex-col gap-3 transition-colors">
			<div class="flex gap-2 flex-wrap">
				{post.tags.map((tag: string) => (
					<span class={badgeClass}>
						#{tag}
					</span>
				))}
			</div>
			<div class="ui-prompt">
				<span class="truncate">
					<ExternalLink size={12} className={`inline -mt-0.5 ${markerClass}`} /> open
					{" "}
					{linkHost}
				</span>
				<span class="ui-prompt-arrow shrink-0">{">"}</span>
			</div>
		</div>
	</div>
</div>

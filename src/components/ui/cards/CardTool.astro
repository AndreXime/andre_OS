---
import { getThemeClasses } from "@/lib/utils";
import { Code2 } from "lucide-react";
import type { Post } from "@/content.config";

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { badgeClass, markerClass, bgClass } = getThemeClasses(post.type);
---

<div class={`ui-card ui-focus-ring cursor-pointer h-full overflow-hidden relative card-trigger`}>
	<div
		class={`h-16 w-full shrink-0 relative border-b border-[var(--color-border)] overflow-hidden ${bgClass}`}
	>
		<div class="h-full w-full flex items-center justify-between gap-3 px-4">
			<div class="flex items-center gap-2 min-w-0">
				<Code2 className={`${markerClass} shrink-0`} size={16} strokeWidth={1.75} />
				{post.tool_name ? (
					<span class="font-mono text-xs text-[var(--color-dim)] truncate">
						./bin/{post.tool_name}
					</span>
				) : (
					<span class="font-mono text-xs text-[var(--color-dim)] truncate">
						./bin/{post.slug}
					</span>
				)}
			</div>
			<span class="font-mono text-[10px] text-[var(--color-dim)] uppercase tracking-widest">
				exec
			</span>
		</div>
	</div>
	<div class="p-4 flex flex-col flex-1 justify-between">
		<div>
			<h3 class="text-lg font-medium text-[var(--color-fg)] mb-2 leading-tight">
				{post.title}
			</h3>
			<p class="text-sm text-[var(--color-dim)] mb-4 line-clamp-4 leading-relaxed">
				{post.description}
			</p>
		</div>
		<div class="mt-auto pt-4 flex flex-col gap-3 transition-colors">
			<div class="flex gap-2 flex-wrap">
				{post.tags.map((tag: string) => (
					<span class={badgeClass}>
						#{tag}
					</span>
				))}
			</div>
			<div class="ui-prompt">
				<span class="truncate">./bin/{post.tool_name ?? post.slug}</span>
				<span class="ui-prompt-arrow shrink-0">{">"}</span>
			</div>
		</div>
	</div>
</div>

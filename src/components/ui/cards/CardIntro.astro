---
import { Cpu, Terminal } from "lucide-react";
import type { Post } from "@/content.config";

interface Props {
	post: Post;
}

const { post } = Astro.props;
---

<div class="ui-card h-full p-6 flex flex-col justify-center relative overflow-hidden">
	<div class="absolute top-0 right-0 p-4 opacity-10 text-[var(--color-fg)]">
		<Cpu size={120} />
	</div>
	<h2 class="text-sm font-mono text-[var(--color-accent)] mb-2 flex items-center gap-2">
		<Terminal size={14} /> README.md
	</h2>
	<p class="text-lg font-bold text-[var(--color-fg)] leading-relaxed relative z-10">
		{post.title}
	</p>
	<p class="text-base font-medium text-[var(--color-muted)] leading-relaxed relative z-10">
		{post.description}
	</p>
</div>

---
import { OS_VERSION } from "@/lib/osPaths";

interface Props {
	path: string;
}

const { path } = Astro.props;
const rssUrl = new URL("rss.xml", Astro.site);
---

<footer class="os-status-bar" aria-label="Barra de status">
	<div class="os-chrome-inner os-status-bar-inner">
		<div class="os-status-bar-left">
			<span class="os-status-brand">andre_OS</span>
			<span class="os-status-version">v{OS_VERSION}</span>
			<span id="os-status-path" class="os-status-path">{path}</span>
		</div>
		<div class="os-status-bar-right">
			<a href={rssUrl} class="os-status-link ui-focus-ring">rss</a>
			<span
				id="os-online-status"
				class="os-status-pill os-status-pill--online">online</span
			>
			<time id="os-clock" class="os-status-clock" datetime="">--:--</time>
		</div>
	</div>
</footer>

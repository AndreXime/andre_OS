---
import { ChevronLeft, SquareTerminal } from "lucide-react";

interface Props {
	promptPath: string;
	backHref?: string | undefined;
	backLabel?: string | undefined;
}

const { promptPath, backHref, backLabel } = Astro.props;
const showBack = backHref && backLabel;

const backLinkClass =
	"ui-focus-ring ml-auto flex w-fit items-center gap-2 rounded-md border border-[var(--color-border)] bg-[color-mix(in_oklch,var(--color-surface-1)_85%,transparent_15%)] px-3 py-1.5 text-sm font-mono text-[var(--color-dim)] transition-colors hover:border-[var(--color-border-strong)] hover:text-[var(--color-fg)] group";
---

<header
	class="w-full z-50 bg-[var(--color-bg)] border-b border-[var(--color-border)]"
>
	<div class="os-chrome-inner py-4">
		<div class="flex items-center justify-between gap-4">
			<a
				href="/"
				class="flex shrink-0 items-center gap-2 cursor-pointer text-lg font-mono font-bold text-[var(--color-fg)] tracking-tight leading-none"
			>
				<SquareTerminal />
				andre_OS
			</a>

			<div class="flex min-w-0 flex-1 max-w-md flex-col">
				{
					showBack ? (
						<a href={backHref} class={backLinkClass}>
							<ChevronLeft
								size={16}
								className="shrink-0 transition-transform group-hover:-translate-x-0.5"
							/>
							{backLabel}
						</a>
					) : (
						<>
							<div class="flex items-center group relative w-full rounded-md border border-[var(--color-border)] bg-[color-mix(in_oklch,var(--color-surface-1)_85%,transparent_15%)] px-3 py-2 focus-within:border-[color-mix(in_oklch,var(--color-accent)_30%,var(--color-border)_70%)] focus-within:ring-1 focus-within:ring-[color-mix(in_oklch,var(--color-focus-ring)_35%,transparent_65%)] transition-all">
								<label for="search" class="os-terminal-prompt">
									<span class="os-terminal-user">
										andre@os:<span id="terminal-path">{promptPath}</span>$
									</span>
									<input
										id="search"
										type="text"
										placeholder="grep, open, cd, help..."
										class="os-terminal-input"
										autocomplete="off"
										spellcheck="false"
									/>
								</label>
							</div>
							<p id="terminal-feedback" class="os-terminal-feedback hidden" />
						</>
					)
				}
			</div>
		</div>
	</div>
</header>

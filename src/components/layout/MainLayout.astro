---
import Nav from "../ui/Nav.astro";
import Footer from "../ui/Footer.astro";

interface Props {
	activeCategory: string;
}

const { activeCategory } = Astro.props;
---

<div class="flex min-h-dvh flex-col">
	<Nav activeCategory={activeCategory} />
	<main class="flex-1">
		<slot />
	</main>
	<Footer />
</div>

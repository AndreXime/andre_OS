---
import type { Post } from "@/content.config";
import {
	getListingTitle,
	getSectionDescription,
	CONTENT_SECTIONS,
	type SectionCategory,
} from "@/lib/sections";
import { accentRailClass } from "@/lib/siteUi";
import ContentTable from "../ui/ContentTable.astro";
import SearchEmpty from "../ui/SearchEmpty.astro";
import MainLayout from "./MainLayout.astro";

interface Props {
	recentPosts: Post[];
	activeCategory: string;
}

const { recentPosts, activeCategory } = Astro.props;

const showEmpty = recentPosts.length === 0;
const listingTitle = getListingTitle(activeCategory);
const isHome = activeCategory === "all";
const homeRecentPosts = isHome ? recentPosts.slice(0, 12) : [];

const emptyClass =
	"rounded-card border border-dashed border-rule p-2xl text-center text-muted";
const categoryCardClass =
	"focus-ring flex min-h-11 flex-col gap-3xs rounded-card border border-accent-muted border-t-[3px] border-t-accent bg-accent-bg p-md no-underline transition-[border-color,background-color] duration-150 ease-out hover:border-accent";
---

<MainLayout activeCategory={activeCategory}>
	<div class="container-page flex flex-col gap-section py-lg pb-3xl">
		{
			isHome ? (
				<>
					<nav aria-label="Seções">
						<ul class="m-0 grid list-none grid-cols-1 gap-sm p-0 lg:grid-cols-3">
							{CONTENT_SECTIONS.map((section) => (
								<li>
									<a
										href={section.href}
										class={categoryCardClass}
									>
										<span class="font-display text-lg font-semibold text-accent">
											{section.title}
										</span>
										<span class="text-sm leading-normal text-ink">
											{section.description}
										</span>
									</a>
								</li>
							))}
						</ul>
					</nav>

					{homeRecentPosts.length ? (
						<section
							class="flex flex-col gap-md"
							aria-labelledby="rail-recente"
						>
							<h2
								id="rail-recente"
								class="m-0 font-display text-xl font-semibold text-accent"
							>
								Recente
							</h2>
							<ContentTable posts={homeRecentPosts} />
						</section>
					) : (
						<div class={emptyClass}>
							<p>Por enquanto não há publicações.</p>
						</div>
					)}
				</>
			) : (
				<section aria-labelledby="listing">
					<header class={`flex flex-col gap-sm ${accentRailClass}`}>
						<h1
							id="listing"
							class="m-0 font-display text-display-s leading-snug font-semibold text-accent"
						>
							{listingTitle}
						</h1>
						<p class="m-0 text-md leading-[var(--lh-prose)] text-muted">
							{getSectionDescription(
								activeCategory as SectionCategory,
							)}
						</p>
					</header>

					{recentPosts.length ? (
						<div class="mt-lg">
							<ContentTable posts={recentPosts} />
						</div>
					) : null}
				</section>
			)
		}

		{
			showEmpty && !isHome ? (
				<div class={emptyClass}>
					<p>Nenhum item publicado nesta seção ainda.</p>
				</div>
			) : null
		}

		<SearchEmpty />
	</div>
</MainLayout>

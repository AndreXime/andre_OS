---
import {
    Command,
    FileText,
    ExternalLink,
    Terminal,
    Search,
    SquareTerminal,
} from "lucide-react";

interface Props {
    currentFilter: string;
    currentSearch: string;
    lastDate: string | undefined;
}
const { currentFilter, currentSearch, lastDate } = Astro.props;
---

<aside
    id="sidebar"
    class="lg:col-span-2 hidden lg:flex lg:sticky lg:top-24 lg:h-full transition-all duration-300 flex-col"
>
    <div
        id="sidebar-backdrop"
        class="lg:hidden fixed inset-0 bg-black/60 backdrop-blur-[2px]"
        aria-hidden="true"
    >
    </div>

    <div
        id="sidebar-panel"
        class="lg:contents fixed right-0 top-0 h-full w-[min(22rem,86vw)] overflow-y-auto border-l border-[var(--color-border)] bg-[var(--color-bg)] p-6 space-y-8"
        role="dialog"
        aria-modal="true"
        aria-label="Menu"
    >
        <a
            href="/"
            class="hidden lg:flex justify-center items-center gap-2 cursor-pointer text-xl font-mono font-bold text-[var(--color-fg)] tracking-tight leading-none"
        >
            <SquareTerminal />
            andre_OS
        </a>
        <form action="/" method="GET" class="flex items-center group relative">
            <Search
                size={14}
                className="absolute left-3 top-2 text-[var(--color-dim)] group-focus-within:text-[var(--color-accent)] transition-colors"
            />
            <input
                type="text"
                name="q"
                value={currentSearch}
                placeholder="Pesquisar notas, ferramentas..."
                class="w-full bg-[color-mix(in_oklch,var(--color-surface-1)_85%,transparent_15%)] border border-[var(--color-border)] text-sm py-1.5 pl-9 pr-4 rounded-md text-[var(--color-muted)] placeholder-[var(--color-dim)] focus:outline-none focus:border-[color-mix(in_oklch,var(--color-accent)_30%,var(--color-border)_70%)] focus:ring-1 focus:ring-[color-mix(in_oklch,var(--color-focus-ring)_35%,transparent_65%)] transition-all font-mono"
            />
            <input
                type="hidden"
                name="category"
                value={currentFilter !== "all" ? currentFilter : ""}
            />
        </form>

        <div class="space-y-1">
            <p
                class="text-xs font-mono text-[var(--color-dim)] uppercase tracking-wider mb-2 pl-2"
            >
                Diretórios
            </p>
            {
                [
                    { id: "all", label: "~/root", Icon: Command },
                    { id: "note", label: "~/notas", Icon: FileText },
                    { id: "link", label: "~/links", Icon: ExternalLink },
                    { id: "tool", label: "~/bin", Icon: Terminal },
                ].map((f) => {
                    const isActive = currentFilter === f.id;
                    const activeClass =
                        "bg-[color-mix(in_oklch,var(--color-surface-2)_85%,transparent_15%)] text-[var(--color-fg)] border-[color-mix(in_oklch,var(--color-accent)_18%,var(--color-border)_82%)]";
                    const inactiveClass =
                        "border-transparent text-[var(--color-muted)] hover:bg-[color-mix(in_oklch,var(--color-surface-1)_85%,transparent_15%)] hover:text-[var(--color-fg)]";

                    return (
                        <a
                            href={
                                f.id === "all"
                                    ? currentSearch
                                        ? `/?q=${currentSearch}`
                                        : "/"
                                    : `/?category=${f.id}${currentSearch ? `&q=${currentSearch}` : ""}`
                            }
                            data-category-link={f.id}
                            class={`w-full text-left px-3 py-2 rounded-md text-sm font-medium flex items-center gap-3 transition-colors border ui-focus-ring ${isActive ? activeClass : inactiveClass}`}
                        >
                            <f.Icon size={14} />
                            {f.label}
                        </a>
                    );
                })
            }
        </div>

        <footer
            class="mt-auto mb-3 w-full text-xs font-mono pl-2 text-[var(--color-dim)]"
        >
            Última atualização: {
                lastDate
                    ? new Intl.DateTimeFormat("pt-BR", {
                          day: "2-digit",
                          month: "2-digit",
                          year: "numeric",
                      }).format(new Date(lastDate))
                    : "00:00"
            }
        </footer>
    </div>
</aside>
<script>
    function setupSidebar() {
        const toggleSidebarBtn = document.getElementById("toggle-sidebar");
        const sidebar = document.getElementById("sidebar");
        const backdrop = document.getElementById("sidebar-backdrop");
        const panel = document.getElementById("sidebar-panel");

        if (!toggleSidebarBtn || !sidebar || !backdrop || !panel) {
            throw new Error("Elementos necessarios não existem");
        }

        const activeSidebarClasses = ["fixed", "inset-0", "z-50", "flex"];

        const open = () => {
            sidebar.classList.remove("hidden");
            sidebar.classList.add(...activeSidebarClasses);
            document.body.classList.add("overflow-hidden");
        };

        const close = () => {
            sidebar.classList.add("hidden");
            sidebar.classList.remove(...activeSidebarClasses);
            document.body.classList.remove("overflow-hidden");
        };

        toggleSidebarBtn.addEventListener("click", () => {
            const isOpen = sidebar.classList.contains("hidden");

            if (isOpen) {
                open();
            } else {
                close();
            }
        });

        backdrop.addEventListener("click", close);

        window.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && !sidebar.classList.contains("hidden")) {
                close();
            }
        });
    }
    setupSidebar();
</script>

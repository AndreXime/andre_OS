---
import type { Post } from "@/content.config";
import CardIntro from "../ui/CardIntro.astro";
import Header from "./Header.astro";
import WorkbenchRow from "../ui/WorkbenchRow.astro";

interface Props {
    introPost: Post | undefined;
    recentPosts: Post[];
    activeCategory: string;
}

const { introPost, recentPosts, activeCategory } = Astro.props;

function getPostUrl(post: Post) {
    switch (post.type) {
        case "note":
            return `/post/${post.slug}`;
        case "tool":
            return `/app/${post.tool_name}`;
        case "link":
            return post.url ?? "#";
        default:
            return "#";
    }
}

const showEmpty = recentPosts.length === 0;
---

<div class="min-h-screen relative flex flex-col">
    <Header activeCategory={activeCategory} />

    <main class="flex-1 w-full">
        <div class="mx-auto w-full max-w-5xl px-4 pt-8 pb-12 space-y-8">
            {
                introPost ? (
                    <section class="space-y-3">
                        <div class="flex items-center justify-between">
                            <h2 class="font-mono text-xs uppercase tracking-widest text-[var(--color-dim)]">
                                ~/root
                            </h2>
                        </div>
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                            <div
                                class={`block group h-full relative ${introPost.featured ? "lg:col-span-2" : "col-span-1"}`}
                            >
                                <CardIntro post={introPost} />
                            </div>
                        </div>
                    </section>
                ) : null
            }

            {
                recentPosts.length ? (
                    <section class="space-y-6">
                        <div class="flex items-center justify-between">
                            <h2 class="font-mono text-xs uppercase tracking-widest text-[var(--color-dim)]">
                                ~/recentes
                            </h2>
                        </div>

                        <div class="ui-card px-4 py-3">
                            <div class="font-mono text-xs text-[var(--color-dim)]">
                                <span class="text-[var(--color-accent)]">
                                    ls
                                </span>{" "}
                                -t{" "}
                                <span class="text-[var(--color-muted)]">
                                    {activeCategory !== "all"
                                        ? `./${activeCategory}`
                                        : "./"}
                                </span>
                                <span
                                    id="search-grep"
                                    class="hidden text-[var(--color-dim)]"
                                >
                                    {" "}
                                    | grep <span id="search-grep-term" />
                                </span>
                            </div>
                        </div>

                        <div class="space-y-3">
                            {recentPosts.map((item) => (
                                <a
                                    href={getPostUrl(item)}
                                    {...(item.type === "link"
                                        ? {
                                              target: "_blank",
                                              rel: "noopener noreferrer",
                                          }
                                        : {})}
                                    class="block"
                                >
                                    <WorkbenchRow post={item} />
                                </a>
                            ))}
                        </div>

                        <div
                            id="search-empty"
                            class="hidden py-20 text-center border border-dashed border-[var(--color-border)] rounded-lg"
                        >
                            <p class="text-[var(--color-dim)] text-lg">
                                Nenhum resultado encontrado para{" "}
                                <span id="search-empty-term" />.
                            </p>
                            <button
                                type="button"
                                id="search-clear"
                                class="mt-4 text-[var(--color-accent)] hover:underline"
                            >
                                Limpar filtros
                            </button>
                        </div>
                    </section>
                ) : null
            }

            {
                showEmpty ? (
                    <div class="py-20 text-center border border-dashed border-[var(--color-border)] rounded-lg">
                        <p class="text-[var(--color-dim)] text-lg">
                            Por enquanto não foi publicado nenhum post
                        </p>
                    </div>
                ) : null
            }
        </div>
    </main>

    <script src="../../lib/filterPosts.ts"></script>
</div>

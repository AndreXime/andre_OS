---
import "../../pages/global.css";

interface Props {
    title: string;
}
const { title } = Astro.props;
const rssUrl = new URL("rss.xml", Astro.site);
---

<!doctype html>
<html lang="pt-br">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="andre_OS: notas, ferramentas web e recomendacoes." />
        <meta name="viewport" content="width=device-width" />
        <meta name="theme-color" content="#1e1e28" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="apple-touch-icon" href="/pwa-192x192.png" />
        <link rel="manifest" href="/manifest.webmanifest" />
        <link
            rel="alternate"
            type="application/rss+xml"
            title="andre_OS"
            href={rssUrl}
        />
        <title>{title}</title>
        <script is:inline>
            if ("serviceWorker" in navigator) {
                window.addEventListener("load", () => {
                    navigator.serviceWorker.register("/sw.js").catch(() => {});
                });
            }
        </script>
    </head>
    <body
        class="selection:bg-[color-mix(in_oklch,var(--color-accent)_25%,transparent_75%)] selection:text-[var(--color-fg)]"
    >
        <slot />
    </body>
</html>

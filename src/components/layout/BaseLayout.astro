---
import "../../pages/global.css";
interface Props {
    title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="pt-br">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="AndreOS" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
    </head>
    <body
        class="selection:bg-[color-mix(in_oklch,var(--color-accent)_25%,transparent_75%)] selection:text-[var(--color-fg)]"
    >
        <slot />
    </body>
</html>

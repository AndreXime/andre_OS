---
import { ChevronLeft } from "lucide-react";
import { SITE_NAME } from "@/content/site";
---

<div class="flex min-h-dvh flex-col bg-paper">
	<header class="border-b-[3px] border-accent bg-accent-bg">
		<div
			class="container-page flex items-center justify-between gap-md py-sm"
		>
			<a
				href="/"
				class="focus-ring inline-flex min-h-11 min-w-0 items-center font-mono text-sm font-semibold text-accent no-underline sm:text-base"
			>
				{SITE_NAME}
			</a>
			<a
				href={"/app"}
				class="focus-ring group ml-auto flex min-h-11 w-fit items-center gap-2 rounded-input border border-rule bg-paper-2 px-3 py-2 text-sm text-muted transition-[border-color,color] duration-150 ease-out hover:border-rule-2 hover:text-ink"
			>
				<ChevronLeft
					size={16}
					className="shrink-0 transition-transform group-hover:-translate-x-0.5"
				/>
				Voltar para ferramentas
			</a>
		</div>
	</header>
	<main class="flex min-h-0 w-full flex-1 flex-col">
		<div class="flex flex-1 [&>*]:min-h-0 [&>*]:min-w-0 [&>*]:flex-1">
			<slot />
		</div>
	</main>
</div>

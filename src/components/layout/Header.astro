---
import { PanelRight, SquareTerminal } from "lucide-react";
---

<header
    class="lg:hidden w-full z-50 bg-zinc-950/80 backdrop-blur-md border-b border-zinc-800 h-14 flex items-center px-4 md:px-6 justify-between transition-all duration-300"
>
    <a
        href="/"
        class="flex items-center gap-2 cursor-pointer text-lg font-mono font-bold text-zinc-100 tracking-tight leading-none"
    >
        <SquareTerminal />
        andre_OS
    </a>

    <div class="flex items-center gap-4 text-xs font-mono text-zinc-300">
        <button
            id="toggle-sidebar"
            aria-label="Abrir e fechar sidebar"
            class="p-1.5 rounded-md text-zinc-500 hover:text-white hover:bg-zinc-800 transition-colors"
        >
            <PanelRight size={18} />
        </button>
    </div>
</header>

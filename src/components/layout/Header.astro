---
import {
	Command,
	ExternalLink,
	FileText,
	Search,
	SquareTerminal,
	Terminal,
} from "lucide-react";

interface Props {
	activeCategory: string;
}

const { activeCategory } = Astro.props;

const navInactive =
	"border-transparent hover:border-[var(--color-border)] hover:bg-[color-mix(in_oklch,var(--color-surface-1)_85%,transparent_15%)]";

const navActive =
	"border-[color-mix(in_oklch,var(--color-accent)_18%,var(--color-border)_82%)] bg-[color-mix(in_oklch,var(--color-surface-2)_85%,transparent_15%)] text-[var(--color-fg)]";

const navLinkBase =
	"ui-focus-ring flex flex-1 grow gap-2 items-center justify-center rounded-md px-2 py-1.5 border transition-colors text-center";
---

<header
	class="w-full z-50 bg-[color-mix(in_oklch,var(--color-bg)_85%,transparent_15%)] backdrop-blur-md border-b border-[var(--color-border)] transition-all duration-300"
>
	<div class="mx-auto w-full max-w-5xl px-4 py-4 space-y-6">
		<div class="flex items-center justify-between gap-4">
			<a
				href="/"
				class="flex shrink-0 items-center gap-2 cursor-pointer text-lg font-mono font-bold text-[var(--color-fg)] tracking-tight leading-none"
			>
				<SquareTerminal />
				andre_OS
			</a>

			<div
				class="flex items-center group relative min-w-0 flex-1 max-w-md"
			>
				<Search
					size={14}
					className="absolute left-3 top-2.5 text-[var(--color-dim)] group-focus-within:text-[var(--color-accent)] transition-colors"
				/>
				<input
					id="search"
					type="text"
					placeholder="Pesquisar notas, ferramentas..."
					class="w-full bg-[color-mix(in_oklch,var(--color-surface-1)_85%,transparent_15%)] border border-[var(--color-border)] text-sm py-2 pl-9 pr-4 rounded-md text-[var(--color-muted)] placeholder-[var(--color-dim)] focus:outline-none focus:border-[color-mix(in_oklch,var(--color-accent)_30%,var(--color-border)_70%)] focus:ring-1 focus:ring-[color-mix(in_oklch,var(--color-focus-ring)_35%,transparent_65%)] transition-all font-mono"
				/>
			</div>
		</div>

		<nav
			class="flex w-full gap-2 font-mono text-xs text-[var(--color-muted)]"
		>
			<a
				href={"/"}
				class={`${navLinkBase} ${activeCategory === "all" ? navActive : navInactive}`}
			>
				<Command size={14} className="inline -mt-0.5 shrink-0" /> ~/root
			</a>
			<a
				href={`/app`}
				class={`${navLinkBase} ${activeCategory === "tool" ? navActive : navInactive}`}
			>
				<Terminal size={14} className="inline -mt-0.5 shrink-0" /> ~/bin
			</a>
			<a
				href={`/post`}
				class={`${navLinkBase} ${activeCategory === "note" ? navActive : navInactive}`}
			>
				<FileText size={14} className="inline -mt-0.5 shrink-0" /> ~/notas
			</a>
			<a
				href={`/link`}
				class={`${navLinkBase} ${activeCategory === "link" ? navActive : navInactive}`}
			>
				<ExternalLink size={14} className="inline -mt-0.5 shrink-0" /> ~/links
			</a>
		</nav>
	</div>
</header>
